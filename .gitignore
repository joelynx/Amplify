app/data/appdata/
!app/data/appdata/.gitkeep

# --- Generated PDFs and TeX scratch ---
*.pdf
*.aux
*.out
*.synctex.gz

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Claude Code project settings ---
.claude/
