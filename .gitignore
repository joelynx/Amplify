# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
*.log

# --- App runtime data ---
# everything under app/data/appdata/ is generated at first launch (DB, logs, caches)
app/data/appdata/
!app/data/appdata/.gitkeep

# --- Generated PDFs and TeX scratch ---
*.pdf
*.aux
*.out
*.synctex.gz

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Claude Code project settings ---
.claude/

# --- Solution pipeline (generated at run time) ---
pipeline/outputs/
pipeline/canary_runs/
pipeline/pipeline.db
pipeline/pipeline.db-*
pipeline/current_batch.json
pipeline/meta.json
pipeline/scripts/_render_bundle.mjs
pipeline/archive/
pipeline/.anthropic_key
pipeline/reports/
pipeline/raw/
pipeline/progress.json
pipeline/*.log
pipeline/*.err
pipeline/*.out
