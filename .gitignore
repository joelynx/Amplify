# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
